{
  "name": "tomelist",
  "compatibility_date": "2026-07-01",
  // Only the workers.dev URL; no per-version preview URLs.
  "preview_urls": false,
  "main": "./worker/src/index.ts",
  "assets": {
    "directory": "./app/dist",
    "not_found_handling": "single-page-application",
    // Without this, browser navigations to /api/* would get index.html.
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "SYNC_GROUP", "class_name": "SyncGroup" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SyncGroup"] }]
}
