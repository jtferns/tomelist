{
  "name": "tomelist",
  "compatibility_date": "2026-07-01",
  // Only the workers.dev URL; no per-version preview URLs.
  "preview_urls": false,
  "main": "./worker/src/index.ts",
  "assets": {
    "directory": "./app/dist",
    "not_found_handling": "single-page-application",
    // Without this, browser navigations to /api/* would get index.html.
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "SYNC_GROUP", "class_name": "SyncGroup" }]
  },
  // Per-IP limits (simple: 10 or 60 s windows). Connects are checked in the
  // Worker, accepted writes inside SyncGroup across all groups.
  "ratelimits": [
    { "name": "SYNC_CONNECTS", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "SYNC_WRITES", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SyncGroup"] }]
}
